{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay-agent-checkpoints",
  "main": "./worker/index.ts",
  "account_id": "0828e3a8588e821a5429917926138d7d",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "relay.getmegaportal.com/*",
      "zone_name": "getmegaportal.com"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://relay.getmegaportal.com",
    "GITHUB_CLIENT_ID": "Ov23liDDvbZTA1Llco4A"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-db",
      "database_id": "8621bc6b-2324-495e-97f3-3b72f2e4f1af",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHECKPOINTS",
      "bucket_name": "relay-checkpoints"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
